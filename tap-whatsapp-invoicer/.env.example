# مفتاح تاب السري — من لوحة Tap Business: Developers > API Keys
# استخدم مفتاح sk_test_... للتجربة، و sk_live_... للتشغيل الفعلي.
TAP_SECRET_KEY=REPLACE_WITH_YOUR_TAP_SECRET_KEY

# اختياري — العملة الافتراضية إن لم تُحدَّد في الأمر أو ملف CSV
TAP_DEFAULT_CURRENCY=SAR

# اختياري — رابط API تاب (غيّره فقط لو طلب منك دعم تاب استخدام بيئة مختلفة)
# TAP_API_BASE_URL=https://api.tap.company/v2

# اختياري — تخصيص جسم "notifications" المرسل مع كل فاتورة (JSON خام).
# القيمة الافتراضية تطلب تفعيل الإرسال عبر واتساب، لكن هذه الأداة لم تتمكن
# من تأكيد اسم الحقل الدقيق من توثيق Tap الرسمي (developers.tap.company كان
# محجوبًا من بيئة البناء). إن لم تصل الفاتورة فعليًا عبر واتساب بعد التجربة،
# تأكد من الصيغة الصحيحة مع دعم Tap أو من لوحة التحكم، وعدّل القيمة هنا.
# TAP_NOTIFICATIONS_PAYLOAD={"channels":["whatsapp"]}
